{
  "version": 1,
  "title": "沙币设置",
  "description": "眼睛、视频、记忆、人格、自主循环、自拍与 QQ 官方机器人的全部配置。保存后即时生效（dataDir 变更需重启）。",
  "groups": [
    {
      "id": "eye",
      "title": "眼睛与屏幕",
      "description": "定时截屏、OCR 与画面理解。隐私优先：默认不落盘，可只识别指定窗口。",
      "fields": [
        {
          "key": "eye.enabled",
          "label": "启用屏幕识别",
          "type": "boolean",
          "default": true,
          "hint": "关闭后 getScreenContext() 返回 null，不截屏。"
        },
        {
          "key": "eye.mode",
          "label": "运行模式",
          "type": "select",
          "options": [
            {
              "value": "interval",
              "label": "定时截屏"
            },
            {
              "value": "manual",
              "label": "仅手动"
            }
          ],
          "default": "interval"
        },
        {
          "key": "eye.intervalSec",
          "label": "截屏间隔",
          "type": "select",
          "options": [
            {
              "value": 5,
              "label": "5 秒"
            },
            {
              "value": 30,
              "label": "30 秒"
            },
            {
              "value": 60,
              "label": "1 分钟"
            }
          ],
          "default": 30
        },
        {
          "key": "eye.capture.display",
          "label": "截屏范围",
          "type": "select",
          "options": [
            {
              "value": "primary",
              "label": "主屏"
            },
            {
              "value": "all",
              "label": "所有屏幕"
            },
            {
              "value": "active",
              "label": "当前活动窗口所在屏"
            }
          ],
          "default": "primary"
        },
        {
          "key": "eye.capture.region",
          "label": "自定义区域",
          "type": "text",
          "placeholder": "x,y,w,h；留空为全屏",
          "hint": "像素坐标，例如 0,0,1920,1080。"
        },
        {
          "key": "eye.capture.command",
          "label": "截屏命令（可选）",
          "type": "textarea",
          "rows": 3,
          "placeholder": "留空使用宿主截屏能力；支持 {output} 占位符",
          "hint": "Linux 示例：gnome-screenshot -f {output}；macOS：screencapture -x {output}。"
        },
        {
          "key": "eye.privacy.paused",
          "label": "暂停屏幕识别",
          "type": "boolean",
          "default": false,
          "hint": "暂停后不截屏、不 OCR，但记忆与聊天仍可用。"
        },
        {
          "key": "eye.privacy.windowAllowlist",
          "label": "只识别这些窗口",
          "type": "list",
          "rows": 4,
          "placeholder": "每行一个窗口标题关键词；留空表示不限制",
          "hint": "匹配窗口标题或应用名；不匹配的窗口直接跳过。"
        },
        {
          "key": "eye.privacy.blurRegions",
          "label": "敏感区域模糊",
          "type": "list",
          "rows": 3,
          "placeholder": "每行 x,y,w,h；可写多行",
          "hint": "在 OCR/视觉理解前对指定区域做高斯模糊。"
        },
        {
          "key": "eye.privacy.storeScreenshots",
          "label": "保存截图文件",
          "type": "boolean",
          "default": false,
          "hint": "默认只在内存中处理；开启后截图落盘到 data/screenshots。"
        },
        {
          "key": "eye.ocr.enabled",
          "label": "启用 OCR",
          "type": "boolean",
          "default": true
        },
        {
          "key": "eye.ocr.languages",
          "label": "OCR 语言",
          "type": "list",
          "rows": 2,
          "placeholder": "chi_sim\neng",
          "hint": "Tesseract 语言包名称，每行一个。"
        },
        {
          "key": "eye.ocr.command",
          "label": "OCR 命令（可选）",
          "type": "textarea",
          "rows": 3,
          "placeholder": "留空使用宿主 OCR；支持 {input}、{output}、{lang}",
          "hint": "命令需把识别文本写入 {output}。"
        },
        {
          "key": "eye.vision.enabled",
          "label": "启用画面理解",
          "type": "boolean",
          "default": true,
          "hint": "需要配置 LLM 视觉模型；缺失时降级为 OCR。"
        },
        {
          "key": "eye.failure.maxConsecutive",
          "label": "连续失败阈值",
          "type": "number",
          "min": 1,
          "max": 30,
          "default": 5,
          "hint": "连续失败达到阈值后暂停一段时间并提示。"
        },
        {
          "key": "eye.failure.backoffSec",
          "label": "失败退避秒数",
          "type": "number",
          "min": 10,
          "max": 600,
          "default": 60
        },
        {
          "key": "__action.eye.test",
          "label": "测试眼睛（立即截屏 + OCR）",
          "type": "action",
          "action": "eyeTest",
          "button": "测试眼睛"
        },
        {
          "key": "__action.eye.pause",
          "label": "暂停 / 恢复屏幕识别",
          "type": "action",
          "action": "eyeToggle",
          "button": "暂停/恢复"
        }
      ]
    },
    {
      "id": "video",
      "title": "视频完整看",
      "description": "0–2 分钟逐帧/关键帧/混合抽帧、ASR、时间轴对齐、场景与事件、完整性校验。",
      "fields": [
        {
          "key": "video.defaultMode",
          "label": "默认抽帧模式",
          "type": "select",
          "options": [
            {
              "value": "frame",
              "label": "逐帧（最完整，帧数最多）"
            },
            {
              "value": "keyframe",
              "label": "仅关键帧（最快）"
            },
            {
              "value": "hybrid",
              "label": "混合（关键帧+每秒+变化帧）"
            }
          ],
          "default": "hybrid"
        },
        {
          "key": "video.coverageThreshold",
          "label": "覆盖率阈值",
          "type": "number",
          "min": 0.99,
          "max": 1,
          "step": 0.001,
          "default": 0.999,
          "hint": "低于该值会补抽/重跑；验收要求 ≥99.9%。"
        },
        {
          "key": "video.maxGapMs",
          "label": "最大空洞（毫秒）",
          "type": "number",
          "min": 500,
          "max": 2000,
          "step": 100,
          "default": 1000,
          "hint": "时间轴每 1 秒必须有覆盖。"
        },
        {
          "key": "video.chunkSec",
          "label": "分块大小（秒）",
          "type": "number",
          "min": 10,
          "max": 120,
          "default": 30
        },
        {
          "key": "video.chunkOverlapSec",
          "label": "分块重叠（秒）",
          "type": "number",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 1
        },
        {
          "key": "video.keyframeSceneThreshold",
          "label": "场景变化阈值",
          "type": "range",
          "min": 0.1,
          "max": 0.9,
          "step": 0.05,
          "default": 0.35,
          "hint": "值越小越敏感，变化帧补偿越多。"
        },
        {
          "key": "video.fpsCap",
          "label": "逐帧 FPS 上限",
          "type": "number",
          "min": 1,
          "max": 60,
          "default": 60
        },
        {
          "key": "video.maxFrames",
          "label": "最大帧数",
          "type": "number",
          "min": 1000,
          "max": 240000,
          "step": 1000,
          "default": 120000
        },
        {
          "key": "video.maxVideoSeconds",
          "label": "最长视频（秒）",
          "type": "number",
          "min": 30,
          "max": 120,
          "default": 120,
          "hint": "规格要求 0–2 分钟；超过会拒绝并提示。"
        },
        {
          "key": "video.analysisWidth",
          "label": "分析宽度",
          "type": "number",
          "min": 480,
          "max": 1920,
          "step": 16,
          "default": 1280
        },
        {
          "key": "video.frameQuality",
          "label": "JPEG 质量",
          "type": "number",
          "min": 1,
          "max": 31,
          "default": 3,
          "hint": "ffmpeg -q:v，数字越小质量越高。"
        },
        {
          "key": "video.analysisBatch",
          "label": "每批理解帧数",
          "type": "number",
          "min": 1,
          "max": 32,
          "default": 8
        },
        {
          "key": "video.holeFill",
          "label": "自动补洞",
          "type": "boolean",
          "default": true
        },
        {
          "key": "video.autoRepair",
          "label": "完整性失败自动重跑",
          "type": "boolean",
          "default": true
        },
        {
          "key": "video.retries",
          "label": "失败重试次数",
          "type": "number",
          "min": 0,
          "max": 5,
          "default": 3
        },
        {
          "key": "video.timelineToleranceMs",
          "label": "时间轴容差（毫秒）",
          "type": "number",
          "min": 50,
          "max": 500,
          "default": 200
        },
        {
          "key": "video.ocrFrames",
          "label": "逐帧 OCR",
          "type": "boolean",
          "default": true,
          "hint": "关闭后仅做视觉理解，画面文字可能缺失。"
        },
        {
          "key": "video.asr.preferSubtitles",
          "label": "优先使用字幕",
          "type": "boolean",
          "default": true,
          "hint": "有 .srt/.vtt/.ass 字幕时优先，并校验时间轴。"
        },
        {
          "key": "video.asr.language",
          "label": "ASR 语言",
          "type": "select",
          "options": [
            {
              "value": "zh",
              "label": "中文"
            },
            {
              "value": "en",
              "label": "英文"
            },
            {
              "value": "auto",
              "label": "自动"
            }
          ],
          "default": "zh"
        },
        {
          "key": "video.asr.command",
          "label": "ASR 命令（可选）",
          "type": "textarea",
          "rows": 3,
          "placeholder": "支持 {input}、{output}、{language}；需输出 JSON 或 SRT",
          "hint": "留空使用宿主 ASR；建议 whisper.cpp / faster-whisper。"
        },
        {
          "key": "video.asrTimeoutSec",
          "label": "ASR 超时（秒）",
          "type": "number",
          "min": 60,
          "max": 1800,
          "default": 600
        }
      ]
    },
    {
      "id": "content",
      "title": "B站 / 小说 / 学习",
      "description": "用户本人登录授权的内容源。插件不代登录、不保存密码；遇验证码/风控立即停止。",
      "fields": [
        {
          "key": "content.bilibili.enabled",
          "label": "启用 B 站内容源",
          "type": "boolean",
          "default": true
        },
        {
          "key": "content.bilibili.cookie",
          "label": "B 站 Cookie（仅自己使用）",
          "type": "password",
          "hint": "从你已登录的浏览器复制 Cookie，粘贴到这里；只保存在本地加密库，不上传。"
        },
        {
          "key": "content.bilibili.feedLimit",
          "label": "每次推荐条数",
          "type": "number",
          "min": 1,
          "max": 30,
          "default": 12
        },
        {
          "key": "content.bilibili.downloadVideo",
          "label": "无字幕时下载视频",
          "type": "boolean",
          "default": false,
          "hint": "下载后走完整视频分析；受下方大小上限限制。"
        },
        {
          "key": "content.bilibili.maxDownloadMB",
          "label": "下载大小上限（MB）",
          "type": "number",
          "min": 10,
          "max": 1024,
          "default": 200
        },
        {
          "key": "content.bilibili.learnSubtitles",
          "label": "优先用字幕学习",
          "type": "boolean",
          "default": true
        },
        {
          "key": "content.novel.defaultUrl",
          "label": "默认小说地址",
          "type": "text",
          "placeholder": "https://example.com/book/123.html"
        },
        {
          "key": "content.novel.cookie",
          "label": "小说站点 Cookie（可选）",
          "type": "password"
        },
        {
          "key": "content.novel.referer",
          "label": "小说站点 Referer（可选）",
          "type": "text"
        },
        {
          "key": "content.novel.autoSummarize",
          "label": "打开时自动概括",
          "type": "boolean",
          "default": false
        },
        {
          "key": "content.learning.autoWriteMemory",
          "label": "学习结果写入长期记忆",
          "type": "boolean",
          "default": true
        },
        {
          "key": "content.learning.maxNotesPerItem",
          "label": "每条内容最多笔记",
          "type": "number",
          "min": 1,
          "max": 40,
          "default": 20
        },
        {
          "key": "__action.content.feed",
          "label": "立即刷一条 B 站",
          "type": "action",
          "action": "contentFeed",
          "button": "刷一条"
        },
        {
          "key": "__action.content.novel",
          "label": "打开默认小说",
          "type": "action",
          "action": "contentNovel",
          "button": "打开小说"
        },
        {
          "key": "__action.content.learn",
          "label": "学习一条 B 站视频",
          "type": "action",
          "action": "contentLearn",
          "button": "学一条"
        }
      ]
    },
    {
      "id": "screenStudy",
      "title": "看视频学习（眼睛）",
      "description": "你播放 B 站/课程视频，插件逐帧截取屏幕画面、视觉理解并写笔记；视觉模型不可用时才 OCR 兜底。不登录平台、不抓视频流。",
      "fields": [
        {
          "key": "screenStudy.enabled",
          "label": "启用看视频学习",
          "type": "boolean",
          "default": true
        },
        {
          "key": "screenStudy.mode",
          "label": "观看方式",
          "type": "select",
          "default": "frame",
          "options": [
            {
              "value": "frame",
              "label": "逐帧视觉（推荐，不依赖 OCR）"
            },
            {
              "value": "subtitle",
              "label": "字幕 OCR"
            }
          ],
          "hint": "逐帧视觉把每一帧交给视觉模型；没有视觉模型时可用 OCR 兜底。"
        },
        {
          "key": "screenStudy.fallbackOcr",
          "label": "视觉不可用时 OCR 兜底",
          "type": "boolean",
          "default": true
        },
        {
          "key": "screenStudy.defaultTitle",
          "label": "默认学习主题",
          "type": "text",
          "placeholder": "例如：B站：机器学习入门"
        },
        {
          "key": "screenStudy.intervalSec",
          "label": "截屏间隔（秒）",
          "type": "number",
          "min": 1,
          "max": 30,
          "default": 4,
          "hint": "视频字幕变化快可设 2–3 秒；只看画面讲解可设 5–8 秒。"
        },
        {
          "key": "screenStudy.maxMinutes",
          "label": "最长学习（分钟）",
          "type": "number",
          "min": 1,
          "max": 180,
          "default": 60
        },
        {
          "key": "screenStudy.notesEveryFrames",
          "label": "每多少帧整理一次笔记",
          "type": "number",
          "min": 2,
          "max": 30,
          "default": 8
        },
        {
          "key": "screenStudy.maxNotesPerSession",
          "label": "每次最多笔记组",
          "type": "number",
          "min": 1,
          "max": 60,
          "default": 20
        },
        {
          "key": "screenStudy.autoWriteMemory",
          "label": "学习结果写入长期记忆",
          "type": "boolean",
          "default": true
        },
        {
          "key": "__action.watch.start",
          "label": "开始看屏幕视频",
          "type": "action",
          "action": "watchStart",
          "button": "开始看"
        },
        {
          "key": "__action.watch.stop",
          "label": "结束并生成学习记录",
          "type": "action",
          "action": "watchStop",
          "button": "停止看"
        }
      ]
    },
    {
      "id": "study",
      "title": "自主学习队列",
      "description": "把本地视频放进学习目录；空闲时自动逐帧学习，覆盖率/置信度不达标会在上限内重学。不登录平台、不抓流。",
      "fields": [
        {
          "key": "study.enabled",
          "label": "启用自主学习",
          "type": "boolean",
          "default": true
        },
        {
          "key": "study.maxPasses",
          "label": "最多重学轮次",
          "type": "number",
          "min": 1,
          "max": 6,
          "default": 3
        },
        {
          "key": "study.minCoverage",
          "label": "掌握覆盖率阈值",
          "type": "number",
          "min": 0.5,
          "max": 1,
          "default": 0.95
        },
        {
          "key": "study.minConfidence",
          "label": "逐帧理解置信度阈值",
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.45
        },
        {
          "key": "study.autoWriteMemory",
          "label": "学习结果写入记忆",
          "type": "boolean",
          "default": true
        },
        {
          "key": "study.addPath",
          "label": "视频文件路径",
          "type": "text",
          "placeholder": "/home/user/videos/lesson.mp4"
        },
        {
          "key": "__action.study.add",
          "label": "加入学习队列",
          "type": "action",
          "action": "studyAdd",
          "button": "加入"
        },
        {
          "key": "__action.study.next",
          "label": "立即学一个",
          "type": "action",
          "action": "studyNext",
          "button": "开始学"
        },
        {
          "key": "__action.study.scan",
          "label": "扫描学习目录",
          "type": "action",
          "action": "studyScan",
          "button": "扫描"
        },
        {
          "key": "__readonly.study.inbox",
          "label": "学习目录",
          "type": "readonly",
          "default": "~/.dsh/shabi/study/inbox"
        }
      ]
    },
    {
      "id": "companion",
      "title": "空闲陪伴",
      "description": "空闲时优先学习队列；只有显式开启 QQ 主动消息后，才会低频、限额地发一句，用户可随时说“别发了”。",
      "fields": [
        {
          "key": "companion.enabled",
          "label": "启用空闲陪伴循环",
          "type": "boolean",
          "default": true
        },
        {
          "key": "companion.intervalSec",
          "label": "检查间隔（秒）",
          "type": "number",
          "min": 60,
          "max": 3600,
          "default": 300
        },
        {
          "key": "companion.autoStudy",
          "label": "空闲时自动学习队列",
          "type": "boolean",
          "default": true
        },
        {
          "key": "companion.proactiveMinIdleMin",
          "label": "你多久没说话才主动",
          "type": "number",
          "min": 5,
          "max": 720,
          "default": 45
        },
        {
          "key": "companion.quietHours",
          "label": "主动消息安静时段",
          "type": "timeRange",
          "default": [
            "23:00",
            "07:00"
          ]
        },
        {
          "key": "companion.fastMode",
          "label": "规则直出（不跑深度决策）",
          "type": "boolean",
          "default": true
        },
        {
          "key": "__action.companion.start",
          "label": "启动 / 停止空闲陪伴",
          "type": "action",
          "action": "companionToggle",
          "button": "切换"
        }
      ]
    },
    {
      "id": "autonomy",
      "title": "自主循环",
      "description": "感知 → 记忆 → 决策 → 白名单动作 → 审计 → 冷却。默认关闭，开启后受每日/每小时上限与安静时段约束。",
      "fields": [
        {
          "key": "autonomy.enabled",
          "label": "启用自主行为",
          "type": "boolean",
          "default": false
        },
        {
          "key": "autonomy.intervalSec",
          "label": "基础间隔（秒）",
          "type": "number",
          "min": 30,
          "max": 1800,
          "default": 180
        },
        {
          "key": "autonomy.jitterSec",
          "label": "随机抖动（秒）",
          "type": "number",
          "min": 0,
          "max": 600,
          "default": 60,
          "hint": "避免机械式固定节奏。"
        },
        {
          "key": "autonomy.dailyLimit",
          "label": "每日动作上限",
          "type": "number",
          "min": 1,
          "max": 200,
          "default": 40
